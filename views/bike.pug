extends base
include _reviewCard

block append head
    //- script(src='/js/mapbox.js')
    

mixin overviewBox(label, text, icon)
    .overview-box__detail
        svg.overview-box__icon
            use(xlink:href=`/img/icons.svg#icon-${icon}`)
        span.overview-box__label= label
        span.overview-box__text= text

block content
    section.section-header
        .header__hero
            .header__hero-overlay &nbsp;
            img.header__hero-img(src=`/img/tours/${bike.imagesCover}`, alt=`${bike.fullName}`)

        .heading-box
            h1.heading-primary
                span= `${bike.fullName}`

            .heading-box__group
                .heading-box__detail
                    svg.heading-box__icon
                        use(xlink:href="/img/icons.svg#icon-clock")
                    span.heading-box__text= `${bike.weight}-kg`

                .heading-box__detail
                    svg.heading-box__icon
                        use(xlink:href="/img/icons.svg#icon-map-pin")
                    span.heading-box__text= bike.startLocation.description

    section.section-description
        .overview-box
            div
                .overview-box__group
                    h2.heading-secondary.ma-bt-lg Quick facts

                    +overviewBox('Category', bike.category, 'calendar')
                    +overviewBox('Size',`${bike.size}`, 'trending-up')
                    +overviewBox('Color',`${bike.color}`, 'user')
                    +overviewBox('Weight',`${bike.weight}-kg`, 'calendar')
                    +overviewBox('Rating',`${bike.ratingsAverage} / 5`, 'star')

                .overview-box__group
                    h2.heading-secondary.ma-bt-lg Your tour guides

                    //- each seller in bike.sellers

                    //- .overview-box__detail
                    //-     img.overview-box__img(src=`/img/users/${sellers.photo}`, alt=`${sellers.name}`)
                    //-     span.overview-box__label= sellers.role
                    //-     span.overview-box__text= sellers.name

        .description-box
            h2.heading-secondary.ma-bt-lg= `About the ${bike.fullName} bike`
            - const paragraphs = bike.description ? bike.description.split('\n') : []
            each p in paragraphs
                p.description__text= p


    section.section-pictures
        each img, i in bike.images
            .picture-box
                img.picture-box__img(
                    src=`/img/tours/${img}`
                    alt=`The Park Camper Tour ${i + 1}`
                    class=`picture-box__img--${i + 1}`
                )

    section.section-map
        #map(data-location=`${JSON.stringify(bike.shopLocation)}`)

    section.section-reviews
        .reviews
            each review in bike.reviews
                +reviewCard(review)


    section.section-cta
        .cta
            .cta__img.cta__img--logo
                img(src="/img/logo-white.png", alt="Natours logo")

            img.cta__img.cta__img--1(src=`/img/tours/${bike.images[1]}`, alt="Bike picture")
            img.cta__img.cta__img--2(src=`/img/tours/${bike.images[2]}`, alt="Bike picture")

            .cta__content
                h2.heading-secondary What are you waiting for?
                p.cta__text= `The ${bike.fullName} give you infinite memories. Make it yours today!`

                
                if user
                    button.btn.btn--green.span-all-rows#buy-bike(data-bike-id=`${bike.id}`) Buy the bike now!
                else
                    a.button.btn.btn--green.span-all-rows(href='/login') Log in to buy this bike!

